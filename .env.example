# GEMINI_API_KEY: Required for Gemini AI API calls (inject your own; never commit a real key).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Fastor staging API base URL (read by src/api/fastorApi.ts).
# Copy this file to .env and keep this value; no secrets here.
VITE_API_URL="https://staging.fastor.ai"

# Demo phone (read by src/hooks/useDisplayMode.ts). Logging in with this number shows
# live API data; any other number shows the Figma sample content. Not a secret.
VITE_API_DEMO_PHONE="9818979450"
